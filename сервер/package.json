{
  "name": "crm-server",
  "version": "0.1.0",
  "private": true,
  "description": "Сервер демо-CRM для магазинов одежды (этап 3)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:migrate": "node scripts/db.js migrate",
    "db:reset": "node scripts/db.js reset",
    "owner:create": "node scripts/create-owner.js",
    "demo:products": "node scripts/demo-products.js",
    "db:backup": "node scripts/backup.js",
    "deploy": "bash scripts/deploy.sh",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8"
  }
}
